# Bob Review Coach — environment variables
# Copy this file to .env.local and fill in your values.

# Required — your IBM Bob inference API key (Scope: Inference)
# Create one at https://bob.ibm.com → API keys
BOB_API_KEY=

# Required — the base URL of the Bob inference API
# e.g. https://your-instance.bob.ibm.com/api/v1
BOB_API_BASE_URL=

# Optional — model identifier to use (defaults to claude-sonnet-4-5)
# BOB_MODEL=claude-sonnet-4-5
